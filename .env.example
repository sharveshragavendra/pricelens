# Firebase Configuration for PriceLens
# Copy this file to .env and fill in values from your Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps (Web)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: set to "true" to also upload compressed product thumbnails to Firebase Storage.
# When omitted or "false", compressed JPEG thumbnails are stored directly inside Firestore
# for zero-configuration setup and instant offline availability.
VITE_FIREBASE_USE_STORAGE=false
